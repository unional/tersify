{
	"name": "tersify-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Tersify monorepo",
	"license": "MIT",
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"clean": "turbo run clean",
		"cs": "changeset",
		"knip": "knip",
		"lint": "biome check",
		"nuke": "run-s nuke:pkgs nuke:root",
		"nuke:pkgs": "turbo run nuke",
		"nuke:root": "rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"tersify": "pnpm --filter=tersify",
		"test": "turbo run test",
		"verify": "run-p knip verify:pkgs",
		"verify:pkgs": "turbo run verify",
		"version": "changeset version",
		"web": "pnpm --filter=website"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"npm-run-all2": "^9.0.3",
		"playwright": "^1.62.1",
		"rimraf": "~6.1.3",
		"turbo": "^2.10.11"
	},
	"packageManager": "pnpm@11.26.0"
}
